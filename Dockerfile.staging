FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev
FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=staging HOST=0.0.0.0 PORT=3000 YUNELA_STAGE_MODE=1 YUNELA_DB_FILE=/app/data/yunela.sqlite YUNELA_TEST_FIXTURES=1
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/dist-server ./dist-server
COPY --from=build --chown=node:node /app/database ./database
RUN mkdir /app/data && chown node:node /app/data
USER node
EXPOSE 3000
CMD ["node","dist-server/f3-runtime.js"]
