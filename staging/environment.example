# Generate separate strong local values; never commit .staging.env.
YUNELA_AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
YUNELA_STAGE_PASSWORD=REPLACE_WITH_RANDOM_20_BYTE_PASSWORD
YUNELA_OPERATOR_EMAIL=operator@example.test
YUNELA_OPERATOR_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_PASSWORD
# Existing HTTPS reverse proxy must retain Host and forward cookies.
YUNELA_PUBLIC_ORIGIN=https://YOUR-STAGING-HOST
